class Shim:
    """Fon vazifasi uchun ctx o'rnini bosadi (faqat bot va bot_data kerak)."""
    def __init__(self, app):
        self.bot, self.bot_data = app.bot, app.bot_data


def pick_target():
    """Admin sozlagan foizga qarab tasodifiy qidiruvda qaysi jins tushishini tanlaydi."""
    b, g = SI("boy_pct", 50), SI("girl_pct", 50)
    if b > g:
        return "yigit"
    if g > b:
        return "qiz"
    n = SI("srch_n", 0) + 1
    setS("srch_n", n)
    return "qiz" if n % 25 == 0 else "yigit"


