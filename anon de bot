async def pair(ctx, a, b):
    pairs = ctx.bot_data["pairs"]
    pairs[a], pairs[b] = b, a
    dead = None
    for me, other in ((a, b), (b, a)):
        x("UPDATE users SET chat_count=chat_count+1 WHERE id=?", (me,))
        await clear_last(ctx, me)
        try:
            await ctx.bot.send_message(me, "✅ <b>Muloqotchi topildi!</b>\n\nYozishingiz mumkin.\n"
                                           "Suhbatni yakunlash: /stop", reply_markup=stop_kb(), parse_mode=HTML)
        except Exception:
            dead = me
            continue
        if link_on(U(me)):
            await send_partner_info(ctx, me, U(other))
    if dead:
        await end_chat(ctx, dead, notify_self=False)


async def do_search(ctx, uid, target=None):
    u = U(uid)
    bd = ctx.bot_data
    async with bd["lock"]:
        if uid in bd["pairs"]:
            return
        bd["wait"][:] = [w for w in bd["wait"] if w["uid"] != uid]
        explicit = target is not None
        t = target or pick_target()
        match = None
        for w in bd["wait"]:
            if w["gender"] != t:
                continue
            if w["target"] and w["target"] != u["gender"]:
                continue
            match = w
            break
        if match:
            bd["wait"].remove(match)
            await pair(ctx, uid, match["uid"])
            return
        bd["wait"].append({"uid": uid, "gender": u["gender"], "target": t if explicit else None,
                           "since": time.time()})
    await say(ctx, uid, "🔎 <b>Muloqotchi qidirilmoqda...</b>\n\nBekor qilish: /stop", UM(uid))


async def matcher(app):
    """Uzoq kutgan tasodifiy qidiruvchilarni (25 soniyadan keyin) bir-biriga ulaydi."""
    shim = Shim(app)
    while True:
        await asyncio.sleep(5)
        try:
            async with app.bot_data["lock"]:
                wait = app.bot_data["wait"]
                old = [w for w in wait if w["target"] is None and time.time() - w["since"] > 25]
                while len(old) >= 2:
                    a, b = old.pop(0), old.pop(0)
                    wait.remove(a)
                    wait.remove(b)
                    await pair(shim, a["uid"], b["uid"])
        except Exception as e:
            logging.warning("matcher error: %s", e)


