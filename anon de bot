def is_modern():
    return S("design", "classic") == "modern"


def amenu(items, back=True):
    """Classic: pastki reply tugmalar. Zamonaviy: chatdagi inline tugmalar."""
    items = list(items) + ([("⬅️ Admin panel", "home")] if back else [])
    rows = [items[i:i + 2] for i in range(0, len(items), 2)]
    if is_modern():
        return ikb([[(l, "a:" + k) for l, k in r] for r in rows])
    return RK([[l for l, k in r] for r in rows])


def back_kb():
    if is_modern():
        return ikb([[("⬅️ Admin panel", "a:home")]])
    return RK([["⬅️ Admin panel"]])


def akb(ctx, uid, rows):
    """Zamonaviy: inline tugmalar. Classic: pastki reply tugmalar (bosilganda mos amal bajariladi)."""
    if is_modern():
        return ikb(rows)
    mp, out, seen = {}, [], set()
    for r in rows:
        line = []
        for t, d in r:
            lab, n = t, 2
            while lab in seen:
                lab, n = f"{t} ({n})", n + 1
            seen.add(lab)
            mp[lab] = d
            line.append(lab)
        out.append(line)
    ctx.bot_data.setdefault("rk", {})[uid] = mp
    return RK(out)


