async def clear_last(ctx, uid, slots=(0, 1)):
    last = ctx.bot_data["last"]
    for s in slots:
        mid = last.pop((uid, s), None)
        if mid and CLEAN_CHAT:
            try:
                await ctx.bot.delete_message(uid, mid)
            except Exception:
                pass


async def say(ctx, uid, text, kb=None, photo=None, slot=0, track=True):
    """Oldingi bot xabarini o'chirib, yangisini yuboradi."""
    if track:
        await clear_last(ctx, uid, (0, 1) if slot == 0 else (1,))
    m = None
    try:
        if photo:
            m = await ctx.bot.send_photo(uid, photo, caption=text, reply_markup=kb, parse_mode=HTML)
    except Exception as e:
        logging.warning("photo send failed %s: %s", uid, e)
    try:
        if m is None:
            m = await ctx.bot.send_message(uid, text, reply_markup=kb, parse_mode=HTML)
    except Exception as e:
        m = None
        if isinstance(kb, ReplyKeyboardMarkup):
            try:
                m = await ctx.bot.send_message(uid, text, reply_markup=strip_icons(kb), parse_mode=HTML)
                if emap():  # ikonkasiz yuborish ishladi, demak muammo premium ikonkada edi
                    logging.warning("premium ikonkali klaviatura yuborilmadi %s: %s", uid, e)
                    await icon_error(ctx, e)
            except Exception as e2:
                logging.warning("send failed %s: %s", uid, e2)
        else:
            logging.warning("send failed %s: %s", uid, e)
        if m is None:
            return None
    if track:
        ctx.bot_data["last"][(uid, slot)] = m.message_id
    return m


async def eat(update):
