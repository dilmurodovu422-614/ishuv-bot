async def relay(update, ctx):
    """Suhbat paytida xabarlarni suhbatdoshga yetkazadi (faqat matn)."""
    m = update.message
    uid = update.effective_user.id
    partner = ctx.bot_data["pairs"].get(uid)
    if canon(m.text or "") == M_STOP:
        await eat(update)
        return await end_chat(ctx, uid)
    if not m.text:
        return await m.reply_text("⚠️ Faqat matn orqali suhbatlasha olasiz.")
    if forbidden(m.text):
        return await m.reply_text("⚠️ Xabaringiz yuborilmadi: username, telefon raqam, havola, guruh/kanal "
                                  "linki va reklama yuborish taqiqlangan.")
    try:
        await ctx.bot.send_message(partner, m.text)
    except Exception:
        await end_chat(ctx, uid)


