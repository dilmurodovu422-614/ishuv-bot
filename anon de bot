async def run_broadcast(ctx, admin, chat_id, msg_id, ads):
    t = time.time()
    sql = "SELECT id FROM users WHERE banned=0 AND registered=1"
    if ads:
        sql += " AND NOT (ads_off=1 AND (vip_until>? OR link_until>?))"
    rows = q(sql, (t, t) if ads else ())
    ok = bad = 0
    for r in rows:
        try:
            await ctx.bot.copy_message(r["id"], chat_id, msg_id)
            ok += 1
        except Exception:
            bad += 1
        await asyncio.sleep(0.05)
    await ctx.bot.send_message(admin, f"✅ Yuborish tugadi.\n📬 Yetkazildi: {ok}\n❌ Xato: {bad}")


