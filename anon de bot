async def pre(update, ctx):
    """Har bir yangilanishdan oldin: foydalanuvchini yozish, ban tekshirish, holatni tozalash."""
    tu = update.effective_user
    if not tu or tu.is_bot:
        return
    u = ensure_user(update)
    m = update.message
    if m and m.text and m.text.startswith("/"):
        ctx.user_data.pop("flow", None)
    if u["banned"] and tu.id not in ADMIN_IDS:
        try:
            await ctx.bot.send_message(tu.id, block_text(), parse_mode=HTML)
        except Exception:
            pass
        raise ApplicationHandlerStop


async def on_message(update, ctx):
    m = update.message
    if not m:
        return
    uid = update.effective_user.id
    u = U(uid)
    if uid in ctx.bot_data["pairs"]:
        return await relay(update, ctx)
    text = canon((m.text or "").strip())
    if text == M_STOP:
        await eat(update)
        return await main_menu(ctx, uid)
    if text == M_CANCEL:
        fl = ctx.user_data.pop("flow", None)
        mid = ctx.bot_data.setdefault("inv", {}).pop(uid, None)
        if mid:  # Stars to'lov oynasi bekor qilinganda olib tashlanadi
            try:
                await ctx.bot.delete_message(uid, mid)
            except Exception:
                pass
        if fl and fl["k"].startswith("a_") and uid in ADMIN_IDS:
            return await a_home(ctx, uid)
        return await main_menu(ctx, uid, "❌ Bekor qilindi.")
    if text == M_ADMIN and uid in ADMIN_IDS:
        ctx.user_data.pop("flow", None)
        await eat(update)
        return await a_home(ctx, uid)
    if text in USER_ACTIONS:
        ctx.user_data.pop("flow", None)
        await eat(update)
        if not u["registered"]:
            return await need_reg(ctx, uid)
        return await USER_ACTIONS[text](ctx, uid)
    if text in ALL_ADMIN and uid in ADMIN_IDS:
        await eat(update)
        return await adm(ctx, uid, ALL_ADMIN[text])
    rk = ctx.bot_data.get("rk", {}).get(uid)
    if rk and text in rk and uid in ADMIN_IDS:
        await eat(update)
        return await admin_cb(ctx, uid, rk[text], None)
    fl = ctx.user_data.get("flow")
    if fl:
        if fl["k"].startswith("a_") and uid in ADMIN_IDS:
            return await admin_flow(update, ctx, fl)
        return await user_flow(update, ctx, fl)
    # Boshqa xabarlar (jumladan suhbat so'zlari) hech qachon o'chirilmaydi.


async def on_cb(update, ctx):
    qy = update.callback_query
    d = qy.data or ""
    uid = update.effective_user.id
    await qy.answer()
    if d == "noop":
        return
    is_admin_cb = d.startswith(ADMIN_CB)
    if is_admin_cb and uid not in ADMIN_IDS:
        return
    if CLEAN_CHAT and not d.startswith(("sp:", "sm:")) and d != "offer":
        try:
            await qy.message.delete()
        except Exception:
            pass
    u = U(uid)
    if is_admin_cb:
        return await admin_cb(ctx, uid, d, qy)
    if d == "offer":
        x("UPDATE users SET offer=1 WHERE id=?", (uid,))
        try:
            if DELETE_OFFER:
                await qy.message.delete()
            else:
                await qy.edit_message_reply_markup(reply_markup=None)
        except Exception:
            pass
        return await reg_start(ctx, uid)
    if d.startswith("g:"):
        fl = ctx.user_data.get("flow")
        if fl and fl["k"] == "reg_gender":
            fl["gender"], fl["k"] = d[2:], "reg_photo"
            await say(ctx, uid, REG_PROMPT["reg_photo"])
        return
    if d == "adm_reg" and uid in ADMIN_IDS:
        if not u["offer"]:
            return await say(ctx, uid, OFFER_TEXT, ikb([[("✅ Roziman", "offer")]]), track=False)
        return await reg_start(ctx, uid)
    if d == "adm_skip" and uid in ADMIN_IDS:
        return await a_home(ctx, uid)
    if not u["registered"]:
        return await need_reg(ctx, uid)
    if d == "chk":
        if await gate(ctx, uid):
            await credit_referral(ctx, uid)
            await main_menu(ctx, uid)
    elif d.startswith("buy:"):
        await buy(ctx, uid, d[4:])
    elif d == "free":
        await show_free(ctx, uid)
    elif d == "topup":
        await u_topup(ctx, uid)
    elif d.startswith("tp:"):
        await ask_amount(ctx, uid, d[3:])
    elif d.startswith("paid:"):
        await ask_receipt(ctx, uid, int(d[5:]))
    elif d == "adtog":
        await toggle_ads(ctx, uid)
    elif d == "faq":
        await show_faq(ctx, uid)
    elif d in FAQ:
        await show_faq_answer(ctx, uid, d)
    elif d == "cmp":
        await start_complaint(ctx, uid)
    elif d == "nxt":
        await u_search(ctx, uid)


