async def admin_flow(update, ctx, fl):
    m = update.message
    uid = update.effective_user.id
    k = fl["k"]
    text = (m.text or "").strip()
    if k not in ("a_chad", "a_bc"):
        await eat(update)

    async def err(t):
        await say(ctx, uid, t + "\n\n" + fl["p"], back_kb())

    async def done(t):
        ctx.user_data.pop("flow", None)
        await say(ctx, uid, t, amenu(ADMIN_MAIN, back=False))

    async def nxt(newk, prompt, **kw):
        fl.update(kw)
        fl["k"], fl["p"] = newk, prompt
        await say(ctx, uid, prompt, back_kb())

    if k == "a_ch_add":
        ref = text
        if ref.startswith("https://t.me/"):
            ref = "@" + ref.rstrip("/").split("/")[-1]
        elif re.fullmatch(r"[A-Za-z]\w{3,}", ref):
            ref = "@" + ref
        elif re.fullmatch(r"-?\d+", ref):
            ref = int(ref)
        try:
            chat = await ctx.bot.get_chat(ref)
        except Exception:
            return await err("❌ Kanal topilmadi: username noto'g'ri yoki bot kanalda yo'q. "
                             "To'g'ri @username yuboring yoki boshqa menyuni tanlang.")
        try:
            me = await ctx.bot.get_chat_member(chat.id, ctx.bot.id)
            ok = me.status in ("administrator", "creator")
        except Exception:
            ok = False
        if not ok:
            return await err("❌ Bot bu kanalda admin emas. Avval botni kanalga admin qiling.")
        link = f"https://t.me/{chat.username}" if chat.username else None
        if not link:
            try:
                link = chat.invite_link or await ctx.bot.export_chat_invite_link(chat.id)
            except Exception:
                return await err("❌ Kanal havolasini olib bo'lmadi. Botga 'havola yaratish' huquqini bering.")
        x("DELETE FROM channels WHERE chat_id=?", (chat.id,))
        x("INSERT INTO channels(chat_id, title, link) VALUES(?, ?, ?)", (chat.id, chat.title or str(chat.id), link))
        return await done(f"✅ Kanal qo'shildi: {esc(chat.title)}")
    if k == "a_chad":
        try:
            await ctx.bot.copy_message(fl["chat"], m.chat_id, m.message_id)
        except Exception:
            await eat(update)
            return await err("❌ Yuborib bo'lmadi. Bot kanalda admin ekanini tekshiring.")
        await eat(update)
        return await done("✅ Reklama kanalga yuborildi.")
    if k == "a_bc":
        ctx.user_data.pop("flow", None)
        task = asyncio.create_task(run_broadcast(ctx, uid, m.chat_id, m.message_id, fl["ads"]))
        tasks = ctx.bot_data.setdefault("tasks", set())
        tasks.add(task)
        task.add_done_callback(tasks.discard)
        return await say(ctx, uid, "📨 Yuborish boshlandi. Tugagach xabar beraman.", amenu(ADMIN_MAIN, False))
    if k == "a_card_owner":
        if not text:
            return await err("❌ Ismni yozing.")
        return await nxt("a_card_num", "💳 16 xonali karta raqamini yozing:", owner=text)
    if k == "a_card_num":
        n = re.sub(r"\D", "", text)
        if len(n) != 16:
            return await err("❌ Karta raqami aniq 16 ta raqam bo'lishi kerak.")
        x("INSERT INTO cards(kind, owner, number) VALUES(?, ?, ?)", (fl["kind"], fl["owner"], n))
        return await done("✅ Karta qo'shildi.")
    if k == "a_pr_price":
        n = num(text)
