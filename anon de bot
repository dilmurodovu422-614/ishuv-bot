async def weekly_awards(app):
    """Har dushanba o'tgan haftaning top 3 referalchisiga sovrinni avtomatik beradi."""
    while True:
        try:
            ws = week_start()
            last = S("award_week")
            if last is None:
                setS("award_week", ws)
            elif float(last) < ws:
                lines = []
                for i, r in enumerate(weekly_top(float(last), ws, 3), 1):
                    days = SI(f"prize_{i}")
                    if days > 0:
                        add_days(r["referrer"], "vip_until", days)
                        add_days(r["referrer"], "link_until", days)
                        try:
                            await app.bot.send_message(
                                r["referrer"], f"🏆 Tabriklaymiz! Siz o'tgan haftaning {i}-o'rnini egalladingiz. "
                                               f"Sizga {days} kunlik VIP va link obunasi berildi!")
                        except Exception:
                            pass
                    lines.append(f"{i}. {r['name']} — {r['c']} ta (+{days} kun)")
                setS("award_week", ws)
                for a in ADMIN_IDS:
                    if lines:
                        try:
                            await app.bot.send_message(a, "🏆 Haftalik reyting sovrinlari berildi:\n" + "\n".join(lines))
                        except Exception:
                            pass
        except Exception as e:
            logging.warning("weekly awards error: %s", e)
        await asyncio.sleep(600)


async def post_init(app):
    app.bot_data.update(pairs={}, wait=[], last={}, lock=asyncio.Lock())
    app.bot_data["matcher_task"] = asyncio.create_task(matcher(app))
    app.bot_data["awards_task"] = asyncio.create_task(weekly_awards(app))


async def on_error(update, ctx):
    logging.error("Xatolik: %s", ctx.error, exc_info=ctx.error)


def main():
    if BOT_TOKEN.startswith("BOT_TOKENNI"):
        raise SystemExit("main.py ichidagi BOT_TOKEN ga bot tokenini yozing (yoki BOT_TOKEN muhit o'zgaruvchisi).")
    app = ApplicationBuilder().token(BOT_TOKEN).post_init(post_init).build()
    app.add_handler(TypeHandler(Update, pre), group=-1)
    app.add_error_handler(on_error)
    app.add_handler(CommandHandler("start", cmd_start))
    app.add_handler(CommandHandler("stop", cmd_stop))
    app.add_handler(CommandHandler("next", cmd_next))
    app.add_handler(CommandHandler("vip", simple_cmd(cmd_vip)))
    app.add_handler(CommandHandler("link", simple_cmd(cmd_link)))
    app.add_handler(CommandHandler("settings", simple_cmd(show_settings)))
    app.add_handler(CommandHandler("rules", simple_cmd(show_rules)))
    app.add_handler(CommandHandler("admin", cmd_admin))
    app.add_handler(CallbackQueryHandler(on_cb))
    app.add_handler(PreCheckoutQueryHandler(precheckout))
    app.add_handler(MessageHandler(filters.SUCCESSFUL_PAYMENT, on_paid))
    app.add_handler(MessageHandler(filters.ChatType.PRIVATE & ~filters.COMMAND, on_message))
    print("Bot ishga tushdi...")
    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()
