# ---- Premium (custom) emoji: reply tugmalarda ----
def emap():
    try:
        return json.loads(S("emoji_map", "{}"))
    except ValueError:
        return {}


def shown(label, em):
    """Premium emoji qo'yilgan tugmada oddiy emoji olib tashlanadi (ikonka o'rniga chiqadi)."""
    if label not in em:
        return label
    return re.sub(r"^[^\w]+", "", label) or label


def canon(text):
    """Tugmada ko'rinadigan matnni asl (kanonik) nomiga qaytaradi."""
    em = emap()
    for lab in em:
        if shown(lab, em) == text:
            return lab
    return text


def kbtn(label, **kw):
    em = emap()
    if label in em:
        return KeyboardButton(shown(label, em), api_kwargs={"icon_custom_emoji_id": em[label]}, **kw)
    return KeyboardButton(label, **kw)


def RK(rows, **kw):
    return ReplyKeyboardMarkup([[kbtn(b) if isinstance(b, str) else b for b in r] for r in rows],
                               resize_keyboard=True, **kw)


def strip_icons(kb):
    """Telegram premium ikonkani qabul qilmasa, tugmalarni ikonkasiz qayta yasaydi."""
    rows = [[KeyboardButton(b.text, request_location=b.request_location or None) for b in r]
            for r in kb.keyboard]
    return ReplyKeyboardMarkup(rows, resize_keyboard=True, one_time_keyboard=kb.one_time_keyboard)


