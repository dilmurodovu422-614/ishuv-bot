def region_of(lat, lon):
    def hav(a1, o1, a2, o2):
        p1, p2 = math.radians(a1), math.radians(a2)
        h = (math.sin((p2 - p1) / 2) ** 2
             + math.cos(p1) * math.cos(p2) * math.sin(math.radians(o2 - o1) / 2) ** 2)
        return 6371 * 2 * math.asin(math.sqrt(h))
    best = min(((hav(lat, lon, a, b), n) for n, (a, b) in REGIONS.items()))
    return best[1] if best[0] < 600 else "Boshqa davlat"


RE_USER = re.compile(r"@\w{3,}")
RE_LINK = re.compile(r"(https?://|www\.|t\.me|telegram\.(me|dog)|tg://|joinchat|"
                     r"\b\w+\.(com|uz|me|ru|org|net|io|info|ly|xyz|link|su)\b)", re.I)


RE_AD = re.compile(r"(obuna\s*bo'?l|kanalimiz|guruhimiz|kanalga\s*(kir|qo'shil|a'zo)|guruhga\s*(kir|qo'shil)|"
                   r"reklama|instagram|\binsta\b|подпиш|наш\s*канал|наша\s*группа|pul\s*ishla)", re.I)


def forbidden(text):
    """username, havola, guruh/kanal linki, reklama yoki telefon raqam bormi"""
    if RE_USER.search(text) or RE_LINK.search(text) or RE_AD.search(text):
        return True
    digits = re.sub(r"[\s\-().+_,]", "", text)
    return bool(re.search(r"\d{7,}", digits))


